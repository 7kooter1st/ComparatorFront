# === Общие ===
# Базовый URL API. Пусто — запросы идут на тот же хост (/api/...).
# Укажите полный URL, если бэкенд на другом домене:
# VITE_API_BASE=https://api.example.com
VITE_API_BASE=

# Путь размещения фронтенда на сервере. Корень сайта:
VITE_BASE_PATH=/
# Подкаталог: VITE_BASE_PATH=/comparator/

# === Только dev/preview (прокси Vite) ===
VITE_API_PROXY_TARGET=http://localhost:5000
# VITE_DEV_PORT=5173
# VITE_PREVIEW_PORT=4173
